# ===================================================================
# Mindora — Environment Variables Template
# Copy this file to .env and fill in your actual credentials:
# cp .env.example .env
# ===================================================================

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_HOST_PORT=5434
DB_PORT=5432
DB_NAME=mindora
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Distributed Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AI Model Configuration (OpenAI or OpenRouter)
OPENAI_API_KEY=your-openai-or-openrouter-api-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Email SMTP Server Configuration (Optional, e.g. Mailtrap or Gmail)
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
